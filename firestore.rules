rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The site is read-only from the client; there is no sign-in flow, so
    // request.auth is always null for web visitors. Writes come from the
    // Admin SDK (Cloud Functions), which bypasses these rules.
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
