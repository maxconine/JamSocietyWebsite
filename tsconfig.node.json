{
  "compilerOptions": {
    "composite": true,
    // Emit outside the source tree; sibling .js output shadows .ts in Vite's resolver.
    "outDir": "./dist/tsbuild",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "target": "ES2020",
    "lib": ["ES2020"],
    "esModuleInterop": true
  },
  "include": ["vite.config.ts", "scripts/**/*.ts"]
}
